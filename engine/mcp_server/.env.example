

# Anonymous Entrez retrieval may have stricter limits.
ENTREZ_EMAIL=
ENTREZ_API_KEY=

# TLS verification stays enabled; fix trust stores or proxies instead of bypassing
# verification.

COSCIENTIST_LIT_REVIEW_DIR=./paper_cache


# Entrez contact email takes precedence; absent both, OpenAlex uses its slower shared pool.
# OPENALEX_MAILTO=your_email@example.com

# OPENALEX_API_KEY=

COSCIENTIST_MCP_PORT=8888
COSCIENTIST_MCP_LOG_LEVEL=INFO


# read_url is keyless; search_web requires a provider key.

# Provider preference is not exclusion: refused or exhausted credentials fall through to the
# other.
WEB_SEARCH_PROVIDER=

# Brave retired its free tier in February 2026; old keys may return 402.
BRAVE_API_KEY=

# Tavily basic search consumes one credit from its monthly allowance.
TAVILY_API_KEY=


# MCP client and server secrets must agree. Unset refuses all requests except GET /.
# COSCIENTIST_MCP_SHARED_SECRET=

# Explicit development-only bypass for actual loopback peers; never set in production.
# COSCIENTIST_MCP_ALLOW_UNAUTHENTICATED_LOCAL=1
