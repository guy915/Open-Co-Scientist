{
  "$schema": "https://unpkg.com/wrangler/config-schema.json",
  "name": "open-coscientist",
  "compatibility_date": "2026-10-08",
  "main": "app/frontend/worker.mjs",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "app/frontend/dist",
    "binding": "ASSETS",
    "html_handling": "none",
    "not_found_handling": "none"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "redact_query_string": false,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true
    },
    "issues": {
      "enabled": true
    }
  }
}
