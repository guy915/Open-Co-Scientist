# syntax=docker/dockerfile:1
# Railway bakes engine source at build time; compose installs its mounted checkout at startup.
# Digest pins keep base images reproducible.
FROM litestream/litestream:0.5.17-scratch@sha256:f757c70d070ac278d45b8847d31a54ab2de24de5e77b09018c642eca263e3967 AS litestream

FROM python:3.12-slim@sha256:646fb0bca3dd3ea1bcc6feb72c17ed16eed6e10cffc732fcc1478bd3e7f02d7b

COPY --from=litestream /usr/local/bin/litestream /usr/local/bin/litestream
COPY litestream.yml /etc/litestream.yml
COPY --chmod=755 scripts/api-entrypoint.sh /usr/local/bin/api-entrypoint

WORKDIR /app

# A reviewed runtime closure prevents unbounded dependency resolution on source changes.
COPY requirements/api.txt /tmp/requirements-api.txt
RUN pip install --no-cache-dir --require-hashes -r /tmp/requirements-api.txt

# Tesseract supplies image OCR and PDF-figure OCR fallback; uploads otherwise fail.
RUN apt-get update && apt-get install -y tesseract-ocr \
    && rm -rf /var/lib/apt/lists/*

# Create the runtime user and the skills closure before any source arrives, so a source
# edit reuses these layers.
RUN groupadd --system coscientist \
    && useradd --system --gid coscientist --home-dir /app coscientist

# Resolve skill dependencies at build time: sandboxed requests must never install from
# indexes.
# The light closure withholds skills whose declared dependencies are absent.
# uv cache contains protected .git metadata, so invoke the prebuilt interpreter directly.
COPY requirements/skills.txt /tmp/requirements-skills.txt
RUN python -m venv /app/skills-venv \
    && /app/skills-venv/bin/pip install --no-cache-dir --require-hashes \
        -r /tmp/requirements-skills.txt
ENV COSCIENTIST_SKILLS_PYTHON=/app/skills-venv/bin/python

# Editable src-layout installs need src/ and the declared README before source contents
# arrive.
COPY engine/pyproject.toml engine/README.md engine/LICENSE engine/NOTICE /workspace/co-scientist-engine/
RUN mkdir -p /workspace/co-scientist-engine/src \
    && pip install --no-cache-dir --no-deps -e /workspace/co-scientist-engine

# Only the SQLite store belongs on the persistent volume.
ENV COSCIENTIST_DB_PATH=/app/data/coscientist.db
# Railway overlays /app/data with a root-owned volume at runtime; image chown cannot reach it.
# RAILWAY_RUN_UID=0 is required for SQLite writes on that mount.
RUN mkdir -p /app/data \
    && chown -R coscientist:coscientist /app /workspace/co-scientist-engine

# Source arrives owned by the runtime user, so no recursive chown follows it.
COPY --chown=coscientist:coscientist engine/src/ /workspace/co-scientist-engine/src/

COPY LICENSE NOTICE /usr/share/doc/co-scientist/

# Confined skill scripts execute in the API process, so this image needs the vendored bundle.
COPY --chown=coscientist:coscientist vendor/science-skills/ ./vendor/science-skills/

# Skills remain opt-in per workspace; installing the bundle does not enable every node.
# Third-party notices must remain available for report attribution.
ENV COSCIENTIST_SKILLS_DIR=/app/vendor/science-skills/skills
# Railway shows log lines as they are written, not when a buffer fills.
ENV PYTHONUNBUFFERED=1

USER coscientist

# Probe explicit imports as the runtime user: unreadable namespace trees can pass an empty
# walk.
# Discard the import-created smoke database.
RUN PYTHON_DOTENV_DISABLED=1 \
    LITELLM_LOCAL_MODEL_COST_MAP=True \
    COSCIENTIST_DB_PATH=/tmp/coscientist-image-smoke.db \
    python -c "import co_scientist.main, co_scientist.core.constants, co_scientist.science.generation; \
import importlib, pkgutil, co_scientist; \
[importlib.import_module(m.name) for m in pkgutil.walk_packages(co_scientist.__path__, 'co_scientist.')]" \
    && rm -f /tmp/coscientist-image-smoke.db*

EXPOSE ${PORT:-8008}

HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:${PORT:-8008}/health', timeout=5)" || exit 1

# Open SSE streams would otherwise hold shutdown until the platform kills the process.
ENTRYPOINT ["/usr/local/bin/api-entrypoint"]
