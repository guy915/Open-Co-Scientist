# Local Vite proxies the API; separately hosted frontends need the deployed API origin.
# VITE_API_BASE_URL=https://api.open-coscientist.com

# Public browser error tracking is optional and read at build time.
# VITE_SENTRY_DSN=

# Cloudflare Web Analytics site token (public, cookieless page views).
# Leave unset on Cloudflare: production uses edge injection (docs/MONITORING.md).
# VITE_CF_WEB_ANALYTICS_TOKEN=
